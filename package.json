{
  "name": "@adeli/chat-sdk-adapter",
  "version": "0.1.0",
  "description": "Adeli adapter for Chat SDK: Instagram, Facebook and WhatsApp DMs, and Instagram and TikTok comments, through one API key",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "chat": "^4.0.0"
  },
  "dependencies": {
    "@adeli/sdk": "^0.3.0",
    "@chat-adapter/shared": "^4.44.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@chat-adapter/state-memory": "^4.44.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "chat": "^4.44.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingscrosslabs/adeli-chat-sdk-adapter.git"
  },
  "homepage": "https://github.com/kingscrosslabs/adeli-chat-sdk-adapter#readme",
  "bugs": {
    "url": "https://github.com/kingscrosslabs/adeli-chat-sdk-adapter/issues"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "adeli",
    "instagram",
    "facebook",
    "whatsapp",
    "tiktok"
  ],
  "license": "MIT"
}
